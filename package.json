{
  "name": "open-dot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "test": "npx tsx -r ./scripts/shim-server-only.cjs src/server/agent/security-hardening-task-a.test.ts && npx tsx -r ./scripts/shim-server-only.cjs src/server/agent/answer-style.test.ts && npx tsx -r ./scripts/shim-server-only.cjs src/server/llm/think-filter.test.ts && npx tsx -r ./scripts/shim-server-only.cjs src/server/agent/prompt.test.ts && npx tsx -r ./scripts/shim-server-only.cjs src/server/agent/context-budget.test.ts && npx tsx -r ./scripts/shim-server-only.cjs src/server/agent/read-page-chunking.test.ts && npx tsx -r ./scripts/shim-server-only.cjs src/server/llm/llm-queue.test.ts && npx tsx -r ./scripts/shim-server-only.cjs src/server/agent/url-validator.test.ts && npx tsx -r ./scripts/shim-server-only.cjs src/server/agent/client-and-ollama.test.ts",
    "check": "npx tsc --noEmit && pnpm test && pnpm build",
    "desktop:dev": "OPEN_DOT_DEV_URL=http://localhost:3100 electron electron",
    "desktop:prepare": "next build && node scripts/desktop-prepare.mjs",
    "desktop": "electron electron",
    "desktop:build": "pnpm desktop:prepare && electron-builder",
    "desktop:build:win": "pnpm desktop:prepare && electron-builder --win",
    "desktop:build:mac": "pnpm desktop:prepare && electron-builder --mac"
  },
  "dependencies": {
    "@composio/core": "0.22.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@next/env": "^16.3.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@swc/helpers": "^0.5.23",
    "@types/pdf-parse": "^1.1.5",
    "croner": "^10.0.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.5.1",
  "build": {
    "appId": "dev.opendot.local",
    "productName": "Open Dot Local",
    "electronVersion": "44.4.5",
    "directories": {
      "app": "electron",
      "output": "dist",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": ".desktop/server",
        "to": "server"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.mjs",
      "package.json",
      "!**/node_modules/**"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/desktop-after-pack.mjs"
  }
}
